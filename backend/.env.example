DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=False
SECRET_KEY=troque-esta-chave-em-desenvolvimento
ALLOWED_HOSTS=localhost,127.0.0.1

# Dados de conexão do Postgres do seu projeto Supabase — Project Settings →
# Database → Connect → aba "Session pooler" (recomendado para dev local, pois
# funciona em redes só-IPv4; a conexão direta em db.<ref>.supabase.co exige
# saída IPv6).
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<senha do banco definida na criação do projeto>
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Testes automatizados rodam no mesmo banco acima, isolados no schema `test`
# (o Supabase não permite criar um segundo banco via CREATE DATABASE) — não
# precisa mudar este valor.
DB_TEST_NAME=postgres

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=troque-pela-service-role-key-do-seu-projeto
SUPABASE_STORAGE_BUCKET=images
SUPABASE_STORAGE_BUCKET_PUBLICO=True

# App cadastrado no DevCenter do Mercado Livre (devcenter.mercadolivre.com.br)
# — CLIENT_ID/CLIENT_SECRET não mudam por usuário; os tokens OAuth de cada
# vendedor ficam no banco (apps.canais.models.MercadoLivreToken), nunca aqui.
# MERCADO_LIVRE_REDIRECT_URI precisa ser https e bater exatamente com o valor
# cadastrado no DevCenter — para testar local, use um túnel (ngrok, etc.)
# apontando pra porta 8000.
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://SEU-TUNEL-OU-DOMINIO/api/v1/canais/mercado-livre/callback

# Para onde o callback OAuth do Mercado Livre redireciona o navegador depois
# de processar o code (sucesso ou erro) — normalmente a URL do frontend.
FRONTEND_URL=http://localhost:5173
